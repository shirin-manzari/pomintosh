{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MiniMac Pomodoro",
  "version": "0.1.0",
  "identifier": "com.pomintosh.minimac",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MiniMac Pomodoro",
        "width": 560,
        "height": 620,
        "minWidth": 360,
        "minHeight": 400,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self'; style-src 'self'; font-src 'self'; script-src 'self'",
      "devCsp": "default-src 'self'; img-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'; connect-src 'self' ws://127.0.0.1:1420"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"]
  }
}
